# Agni's Capsule Environment Configuration

# Database (PostgreSQL for Docker/Production, SQLite fallback in local development)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/agni_capsule
# DATABASE_URL=sqlite+aiosqlite:///./agni_capsule.db

# JWT & Cryptographic Security
SECRET_KEY=replace-with-a-secure-random-64-character-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Sovereign Google Drive OAuth (drive.file scope)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5173/vault
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Notification Channels (Optional / Configurable)
SMTP_HOST=kishoreprocode.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

